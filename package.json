{
	"name": "01",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:web": "vite dev --mode web",
		"dev:wordpress": "vite dev --mode wordpress",
		"dev:studio": "cd .internal/slide-studio && npm run dev -- --host localhost --port 5175",
		"dev:all": "node scripts/dev-all.mjs",
		"build": "rm -rf .svelte-kit/output && vite build",
		"build:web": "rm -rf .svelte-kit/output && vite build --mode web",
		"build:wordpress": "rm -rf .svelte-kit/output && vite build --mode wordpress",
		"preview": "vite preview",
		"preview:web": "vite preview --mode web",
		"preview:wordpress": "vite preview --mode wordpress",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.14",
		"@types/node": "^22",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.14",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.10"
	},
	"dependencies": {
		"@midudev/tailwind-animations": "^0.2.0",
		"highlight.js": "^11.9.0",
		"marked": "^12.0.2",
		"remixicon": "^4.7.0",
		"yaml": "^2.7.0"
	}
}
